# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Never commit real values.
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# Postgres container (docker-compose.yml)
POSTGRES_USER=geocore
POSTGRES_PASSWORD=
POSTGRES_DB=geocore

# App connection to the container from your machine (port 5433), same credentials as above
DATABASE_URL=postgresql+asyncpg://geocore:<POSTGRES_PASSWORD>@localhost:5433/geocore

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
